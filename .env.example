# ---------------------------------------------------------------------------
# A Million Squares — environment
# Copy to .env.local for development. Never commit a filled-in copy.
# ---------------------------------------------------------------------------

# Public base URL, no trailing slash. Used in emails, share cards, and Stripe
# redirect URLs, so it must be correct in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# A managed Postgres instance (Neon, Supabase, RDS...), deliberately separate
# from the application. Buyer and square data must never be at risk from a code
# deploy. Make sure automatic backups are on.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# --- Stripe ----------------------------------------------------------------
# Start with test-mode keys (sk_test_...) and Stripe's test cards. Swap to live
# keys only when you are ready to take real money.
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen` locally, or the webhook endpoint's signing secret in the
# Stripe dashboard. Required: unsigned webhooks are rejected.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Secrets ---------------------------------------------------------------
# Single shared moderator password. /admin is not linked anywhere public.
ADMIN_PASSWORD=change-me
# Signs the admin session cookie and salts stored reporter-IP hashes.
# Generate with: openssl rand -base64 32
SESSION_SECRET=change-me
# Guards /api/cron/dispatch. On Vercel, setting CRON_SECRET makes the platform
# send it as a Bearer token automatically.
CRON_SECRET=change-me

# --- Image storage ---------------------------------------------------------
# local = ./storage-dev (development only) | s3 = any S3-compatible bucket
STORAGE_DRIVER=local
# Where images are served from. For local, leave as /uploads. For S3/R2, the
# public bucket or CDN base, e.g. https://images.amillionsquaresworld.com
STORAGE_PUBLIC_BASE_URL=/uploads
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=            # set for R2/B2; leave blank for AWS S3
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email -----------------------------------------------------------------
# console = print to the log (development) | resend = send for real
EMAIL_DRIVER=console
EMAIL_FROM="A Million Squares <hello@amillionsquaresworld.com>"
# RESEND_API_KEY=

# --- CSAM scanning ---------------------------------------------------------
# none       = no scanning. Development only. DO NOT LAUNCH ON THIS.
# cloudflare = Cloudflare's free CSAM Scanning Tool, enabled per-zone in the
#              Cloudflare dashboard; requires serving uploads through Cloudflare.
# webhook    = POST each upload to your own scanning service.
CSAM_SCANNER=none
# CSAM_WEBHOOK_URL=
# CSAM_WEBHOOK_TOKEN=

# --- Legal details ---------------------------------------------------------
# Until these are set, the policy pages render with visible [PLACEHOLDER]
# markers and a warning banner. See docs/pre-launch-checklist.md.
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_ABUSE_EMAIL=
LEGAL_DMCA_AGENT=
LEGAL_DMCA_EMAIL=
LEGAL_MAILING_ADDRESS=
LEGAL_GOVERNING_LAW=
LEGAL_EFFECTIVE_DATE=
